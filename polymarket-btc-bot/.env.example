# ═══════════════════════════════════════════════════════════════════
# Polymarket BTC 5-Minute Trading Bot - Configuration
# ═══════════════════════════════════════════════════════════════════

# ─── Mode ─────────────────────────────────────────────────────────
# true = paper trading (no real orders), false = live trading
DRY_RUN=true

# ─── Polymarket Wallet & API ──────────────────────────────────────
# Only required for live trading (DRY_RUN=false)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
CHAIN_ID=137

# ─── Network Endpoints ────────────────────────────────────────────
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# ═══════════════════════════════════════════════════════════════════
# STRATEGY: MARKET MAKING (Phase 1: 10-180s)
# ═══════════════════════════════════════════════════════════════════
# Half-spread per side (e.g., 0.03 = bid at mid-3c, ask at mid+3c)
MM_SPREAD=0.03
# Size per order side (USDC)
MM_SIZE=10
# Max net inventory before aggressive skewing (USDC)
MM_MAX_INVENTORY=30
# Quote skew intensity (0-1, higher = more aggressive rebalancing)
MM_SKEW_FACTOR=0.5
# When to start/stop market making (seconds from window open)
MM_START_SECONDS=10
MM_END_SECONDS=180

# ═══════════════════════════════════════════════════════════════════
# STRATEGY: MOMENTUM (Phase 2: 60-240s)
# ═══════════════════════════════════════════════════════════════════
# Minimum composite signal strength to trigger (0-1)
MOM_THRESHOLD=0.6
# Base position size (USDC)
MOM_SIZE=15
# Maximum position size (USDC)
MOM_MAX_SIZE=40
# Active window (seconds)
MOM_START_SECONDS=60
MOM_END_SECONDS=240

# ═══════════════════════════════════════════════════════════════════
# STRATEGY: ENDGAME ARBITRAGE (Phase 3: 240-285s)
# ═══════════════════════════════════════════════════════════════════
# Minimum BTC price displacement from window open (e.g., 0.003 = 0.3%)
ARB_MIN_DISPLACEMENT=0.003
# Minimum edge vs market price to enter (probability units)
ARB_PROB_THRESHOLD=0.08
# Base size (USDC)
ARB_SIZE=25
# Maximum size (USDC)
ARB_MAX_SIZE=60
# Active window (seconds) - last 60s before resolution
ARB_START_SECONDS=240
# Hard cutoff - no new trades after this (too close to resolution)
ARB_CUTOFF_SECONDS=285

# ═══════════════════════════════════════════════════════════════════
# STRATEGY: GLOBAL
# ═══════════════════════════════════════════════════════════════════
# Minimum probability edge to take any directional trade
EDGE_THRESHOLD=0.04
# Don't trade in first N seconds (price discovery)
WARMUP_PERIOD=10
# Stop trading this window if cumulative loss exceeds this (USDC)
MAX_LOSS_PER_WINDOW=20

# ═══════════════════════════════════════════════════════════════════
# RISK MANAGEMENT
# ═══════════════════════════════════════════════════════════════════
# Market Making Limits
MM_MAX_GROSS_EXPOSURE=60
MM_MAX_NET_DELTA=30
MM_INVENTORY_SKEW_START=15

# Directional Limits
DIR_MAX_POSITION=50
DIR_MAX_TOTAL=100
DIR_STOP_LOSS_PCT=0.20
DIR_TAKE_PROFIT_PCT=0.40

# Global Limits
MAX_LOSS_PER_HOUR=80
MAX_LOSS_PER_DAY=200
MAX_TRADES_PER_HOUR=60
MIN_TRADE_INTERVAL=2.0
MIN_EDGE_AFTER_FEES=0.01

# Fee Structure (Polymarket current rates)
TAKER_FEE_RATE=0.07
MAKER_REBATE_RATE=0.20

# ═══════════════════════════════════════════════════════════════════
# SIGNAL ENGINE
# ═══════════════════════════════════════════════════════════════════
# Category weights (should roughly sum to 1.0)
SIG_TREND_WEIGHT=0.30
SIG_FLOW_WEIGHT=0.30
SIG_MICRO_WEIGHT=0.25
SIG_REVERSION_WEIGHT=0.15
# Convergence: how many signals must agree for high confidence
SIG_CONVERGENCE_MIN=3
SIG_CONVERGENCE_THRESHOLD=0.5

# ═══════════════════════════════════════════════════════════════════
# BACKTEST
# ═══════════════════════════════════════════════════════════════════
BT_START_DATE=2026-05-08
BT_DAYS=7
BT_BALANCE=1000
BT_BASE_SPREAD=0.02
